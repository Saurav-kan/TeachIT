# Copy to .env. Keep the API key on the server, never in browser code.
OPENCODE_API_KEY=
OPENCODE_MODEL=muse-spark-1.3-contributor
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Set true only after checking that this model/endpoint accepts image inputs.
OPENCODE_VISION=true
PORT=3210
